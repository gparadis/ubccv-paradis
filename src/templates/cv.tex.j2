% UBC CV structural macros
\newcommand{\cvsection}[2]{\vspace{8pt}\par\noindent\textbf{#1}\quad\textbf{\underline{#2}}\par\vspace{2pt}}
\newcommand{\cvheading}[1]{\vspace{8pt}\par\noindent\textbf{\underline{#1}}\par\vspace{2pt}}
\newcommand{\cvsub}[2]{\vspace{4pt}\par\noindent\textit{(#1)}\quad\textit{#2}\par\vspace{1pt}}
\newcommand{\cvminor}[1]{\par\noindent\textbf{#1}\par}
\newcommand{\cvempty}{\par\noindent\textit{(none to report)}\par}
% Table cells: smaller, ragged right, and reluctant to hyphenate, because most
% of them hold proper nouns and agency names.
\setlength{\tabcolsep}{4pt}
\newcolumntype{L}[1]{>{\RaggedRight\small\hyphenpenalty=5000\arraybackslash}p{#1}}
\newenvironment{cvlist}{\begin{itemize}[leftmargin=1.5em,itemsep=1pt,topsep=2pt,parsep=0pt]}{\end{itemize}}

% Descending-numbered list, matching the original CV's numbering.
\newcounter{cvrev}
\newenvironment{cvrevlist}[1]{%
  \setcounter{cvrev}{\numexpr#1+1\relax}%
  \begin{list}{\arabic{cvrev}.}{%
    \setlength{\leftmargin}{2.6em}\setlength{\labelwidth}{2.2em}%
    \setlength{\itemsep}{3pt}\setlength{\topsep}{3pt}\setlength{\parsep}{0pt}%
    \setlength{\labelsep}{0.4em}}%
  \let\origitem\item
  \renewcommand{\item}{\addtocounter{cvrev}{-1}\origitem}%
}{\end{list}}

